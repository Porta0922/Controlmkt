{
  "manifest_version": 3,
  "name": "ControlMKT — Guardar sesión",
  "version": "1.0.0",
  "description": "Exporta la sesión de la red social abierta para usarla localmente en ControlMKT.",
  "permissions": ["activeTab", "cookies", "downloads"],
  "optional_host_permissions": ["https://*.x.com/*", "https://*.twitter.com/*", "https://*.instagram.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Guardar sesión para ControlMKT" }
}
